    {"role": "roles/deploymentmanager.editor", "members": ["user:dm-deployer@example.com"]},
    {"role": "projects/project/roles/functionDeployer", "members": ["serviceAccount:fn-deploy@project.iam.gserviceaccount.com"]},
    {"role": "projects/project/roles/tokenSigner", "members": ["user:token-signer@example.com"]},
    {"role": "roles/secretmanager.secretAccessor", "members": ["user:app-dev@example.com"]},
